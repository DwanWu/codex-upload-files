name: Network Slate
desc: 人工智能检测系统
category: Network
version: '4.4.0'
tiles:
  - name: wzw-ip-quality-ippure-44
    interval: 600
    collapsed: true
    title: IP
    content: 等待检测
    icon: shield
    backgroundColor: '#303745'
  - name: wzw-ai-service-slate-node-43
    interval: 1800
    collapsed: true
    title: AI
    content: 等待检测
    icon: sparkles
    backgroundColor: '#303745'
script-providers:
  wzw-ip-quality-ippure-44:
    interval: 86400
    payload: |
      (function () {
        // Source: https://ippure.com/MyIP-Info-API
        // IPPure risk is fraudScore, lower is better. Display purity = 100 - risk.
        // Native Stash node detail routing is intentionally preserved; no forced proxy header.
        var finished=false;
        var slate='#303745';
        var endpoint='https://my.ippure.com/v1/info';
        function log(obj){try{console.log('IPPure '+JSON.stringify(obj));}catch(e){}}
        function complete(title,content,icon,url,detail){
          if(finished)return;
          finished=true;
          log(detail);
          $done({title:title,content:content,icon:icon,backgroundColor:slate,url:url||'https://ippure.com/'});
        }
        function failed(label,detail){
          complete('IP·—',label,'exclamationmark.shield','https://ippure.com/',{source:'IPPure',checkedAt:new Date().toISOString(),status:'error',detail:detail});
        }
        function isV4(v){
          return typeof v==='string'&&/^\d{1,3}(\.\d{1,3}){3}$/.test(v)&&v.split('.').every(function(p){return Number(p)<=255;});
        }
        function isV6(v){
          return typeof v==='string'&&v.length<=45&&v.indexOf(':')>=0&&/^[0-9a-f:.]+$/i.test(v);
        }
        function readRisk(v){
          if(typeof v==='string'&&/^\d+(?:\.\d+)?$/.test(v.trim()))v=Number(v);
          return typeof v==='number'&&isFinite(v)&&v>=0&&v<=100?v:null;
        }
        function clean(v){
          return typeof v==='string'&&v.trim()?v.trim().replace(/\s+/g,' '):null;
        }
        function flag(cc){
          return /^[A-Z]{2}$/.test(cc)?String.fromCodePoint(127397+cc.charCodeAt(0),127397+cc.charCodeAt(1))+' ':'';
        }
        function bool(v){return typeof v==='boolean'?v:null;}
        function render(d){
          if(!d||typeof d!=='object'||Array.isArray(d)||(!isV4(d.ip)&&!isV6(d.ip))){
            failed('返回数据无效','Missing or invalid IP in IPPure response');return;
          }
          var v6=isV6(d.ip);
          // IPPure explicitly does not assign IPv6 risk coefficients.
          var rawRisk=v6?null:readRisk(d.fraudScore);
          var purity=rawRisk===null?null:Number((100-rawRisk).toFixed(8));
          var cc=(clean(d.countryCode)||'').toUpperCase();
          var residential=bool(d.isResidential),broadcast=bool(d.isBroadcast);
          var detail={
            source:'IPPure',endpoint:endpoint,checkedAt:new Date().toISOString(),status:rawRisk===null?'unscored':'ok',
            ip:d.ip,country:clean(d.country),countryCode:cc||null,region:clean(d.region),city:clean(d.city),
            asn:d.asn===undefined?null:d.asn,asOrganization:clean(d.asOrganization),
            fraudScore:rawRisk,returnedFraudScore:d.fraudScore===undefined?null:d.fraudScore,purity:purity,
            formula:'100 - fraudScore',isResidential:residential,isBroadcast:broadcast,
            networkType:residential===true?'住宅网络':residential===false?'非住宅网络':'未知',
            nativeType:broadcast===true?'广播 IP':broadcast===false?'原生 IP':'未知',
            reason:rawRisk!==null?null:v6?'IPPure does not score IPv6':'Missing or invalid fraudScore'
          };
          var displayIp=d.ip;
          if(v6&&displayIp.length>15)displayIp=displayIp.slice(0,7)+'…'+displayIp.slice(-5);
          var icon=rawRisk===null?'shield.lefthalf.filled':rawRisk>=50?'exclamationmark.shield':'checkmark.shield';
          var subtitle=flag(cc)+displayIp;
          complete('IP·'+(purity===null?'—':purity),subtitle,icon,'https://ippure.com/?ip='+encodeURIComponent(d.ip),detail);
        }
        setTimeout(function(){failed('检测超时','IPPure request timeout');},12000);
        try {
          $httpClient.get({
            url:endpoint,timeout:10,
            headers:{Accept:'application/json','Cache-Control':'no-cache, no-store, max-age=0',Pragma:'no-cache'},
            'auto-cookie':false,'auto-redirect':true
          },function(error,response,data){
            if(finished)return;
            var code=response?Number(response.status||response.statusCode):0;
            if(error||code!==200){failed(code?'HTTP '+code:'请求失败',String(error||'HTTP '+code));return;}
            var d;
            try{d=typeof data==='string'?JSON.parse(data):data;}catch(e){failed('数据格式错误','Invalid JSON');return;}
            try{render(d);}catch(e){failed('解析失败',String(e));}
          });
        }catch(e){failed('请求失败',String(e));}
      })();
  wzw-ai-service-slate-node-43:
    interval: 86400
    payload: |
      (function () {
        var services=[
          {name:'Chatgpt',web:'https://chatgpt.com/',api:'https://api.openai.com/v1/models',headers:{}},
          {name:'Claude',web:'https://claude.ai/',api:'https://api.anthropic.com/v1/models',headers:{'anthropic-version':'2023-06-01'}},
          {name:'Gemini',web:'https://gemini.google.com/',api:'https://generativelanguage.googleapis.com/v1beta/models',headers:{}}
        ];
        var results=services.map(function(){return {web:null,api:null};}),left=6,finished=false;
        function time(){var d=new Date();return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);}
        function finish(){
          if(finished)return;finished=true;
          var responded=0,normal=0,restricted=0,failed=0,signs=[],delays=[],detail=[];
          var labels=['Chatgpt','Claude','Gemini'];
          services.forEach(function(s,i){
            var w=results[i].web||{text:'超时',state:'fail',http:false},a=results[i].api||{text:'超时',state:'fail',http:false};
            var has=w.http||a.http,ok=w.state==='ok'&&(a.state==='ok'||a.state==='auth'),region=w.state==='region'||a.state==='region';
            if(has)responded++;if(ok)normal++;if(region)restricted++;if(!has)failed++;
            var sign=ok?'✓':region||!has?'×':'◐';
            signs.push(labels[i]+sign);
            delays.push(typeof a.ms==='number'&&a.http?(a.ms<10000?String(Math.max(0,Math.round(a.ms))):'10k+'):'—');
            detail.push({name:s.name,web:w,api:a,sign:sign});
          });
          try{console.log('Ai details '+JSON.stringify({responded:responded,services:detail}));}catch(e){}
          $done({title:'AI·'+responded,content:signs.join(' '),
            icon:restricted>0||failed>0?'exclamationmark.triangle':'sparkles',
            backgroundColor:'#303745'});
        }
        function classify(s,kind,error,res,data,ms){
          var code=res?Number(res.status||res.statusCode):0;
          function out(text,state){return {text:text,state:state,http:!!code,ms:ms};}
          if(error||!code)return {text:/timeout|timed out|超时/i.test(String(error))?'超时':'连接失败',state:'fail',http:false,ms:ms};
          var str=typeof data==='string'?data:'',obj=null;
          try{obj=JSON.parse(str);}catch(e){}
          var er=obj&&obj.error?obj.error:{},message=typeof er.message==='string'?er.message:'',errcode=String(er.code||''),errtype=String(er.type||''),details=JSON.stringify(er.details||[]);
          var headers=res.headers||{},loc='',challenge=false;
          Object.keys(headers).forEach(function(k){var v=String(headers[k]||'');if(k.toLowerCase()==='location')loc=v;if(k.toLowerCase()==='cf-mitigated'&&/challenge/i.test(v))challenge=true;});
          var regionText=kind==='api'?message+' '+errcode+' '+errtype+' '+details:loc;
          if(/unsupported[_ -](country|region|territory)|country[_ -]not[_ -]supported|(?:country|region|territory).{0,60}(?:not supported|not available|unsupported)|user location is not supported|not available in (?:your|this) (?:country|region|location)|unavailable[-_]in[-_](?:your[-_])?(?:country|region)/i.test(regionText))return out('地区受限','region');
          if(challenge||/<title[^>]*>\s*just a moment|cf-chl-|attention required!.*cloudflare/i.test(str.slice(0,16000)))return out('安全验证','check');
          if(kind==='web'){
            if(code>=200&&code<300)return out('正常','ok');
            if(code>=300&&code<400)return out('跳转 '+code,'check');
          }else{
            if(code>=200&&code<300&&obj&&(Array.isArray(obj.data)||Array.isArray(obj.models)))return out('正常','ok');
            var auth=false;
            if(s.name==='Chatgpt')auth=code===401&&!!obj&&/api.?key|bearer|authentication|authorization/i.test(message+' '+errcode+' '+errtype);
            if(s.name==='Claude')auth=code===401&&!!obj&&(/authentication_error/i.test(errtype)||/api.?key|authentication/i.test(message));
            if(s.name==='Gemini')auth=[400,401,403].indexOf(code)>=0&&!!obj&&/API_KEY_INVALID|API_KEY_MISSING|API key|unregistered callers?|API keys|UNAUTHENTICATED/i.test(message+' '+details+' '+String(er.status||''));
            if(auth)return out('待鉴权','auth');
          }
          if(code===403)return out('403 待确认','check');
          if(code===429)return out('限流','check');
          if(code>=500)return out('服务 '+code,'fail');
          return out('HTTP '+code,'check');
        }
        function run(s,i,kind){
          var start=Date.now(),headers={'Accept':kind==='api'?'application/json':'text/html,application/xhtml+xml','Cache-Control':'no-cache, no-store','Pragma':'no-cache'};
          if(kind==='api')Object.keys(s.headers).forEach(function(k){headers[k]=s.headers[k];});
          function record(result){if(finished||results[i][kind])return;results[i][kind]=result;if(--left===0)finish();}
          try{$httpClient.get({url:s[kind],headers:headers,timeout:8,'auto-cookie':false,'auto-redirect':false},function(e,r,d){
            try{record(classify(s,kind,e,r,d,Date.now()-start));}catch(err){record({text:'响应异常',state:'fail',http:false});}
          });}catch(e){record({text:'请求失败',state:'fail',http:false});}
        }
        setTimeout(finish,11000);
        services.forEach(function(s,i){run(s,i,'web');run(s,i,'api');});
      })();
