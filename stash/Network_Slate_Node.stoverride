name: Network Slate
desc: 人工智能检测系统
category: Network
version: '4.3.0'
tiles:
  - name: wzw-ip-quality-slate-node-43
    interval: 1800
    collapsed: true
    title: IP
    content: 等待检测
    icon: shield
    backgroundColor: '#303745'
  - name: wzw-ai-service-slate-node-43
    interval: 1800
    collapsed: true
    title: AI
    content: 等待检测
    icon: sparkles
    backgroundColor: '#303745'
script-providers:
  wzw-ip-quality-slate-node-43:
    interval: 86400
    payload: |
      (function () {
        var finished=false, primary=null, secondary=null, statusA='未完成',statusB='未完成';
        var slate='#303745';
        function score(v){if(typeof v==='string'&&/^\d+(?:\.\d+)?$/.test(v.trim()))v=Number(v);return typeof v==='number'&&isFinite(v)&&v>=0&&v<=100?Math.round(v):null;}
        function clean(v){return typeof v==='string'&&v.trim()?v.trim().replace(/\s+/g,' '):'未知';}
        function flag(cc){return /^[A-Z]{2}$/.test(cc)?String.fromCodePoint(127397+cc.charCodeAt(0),127397+cc.charCodeAt(1))+' ':'';}
        function merge(a,b){return a===true||b===true?true:a===false||b===false?false:null;}
        function log(v){try{console.log('Ip details '+JSON.stringify(v));}catch(e){}}
        function done(title,content,icon,url){if(finished)return;finished=true;$done({title:title,content:content,backgroundColor:slate,icon:icon,url:url||'https://ipquery.io/'});}
        function request(url,timeout,cb){
          var called=false;
          function end(data,reason){if(called||finished)return;called=true;cb(data,reason);}
          try{$httpClient.get({url:url,timeout:timeout,headers:{Accept:'application/json','Cache-Control':'no-cache, no-store','Pragma':'no-cache'},'auto-cookie':false,'auto-redirect':false},function(e,r,d){
            if(finished||called)return;
            var code=r?Number(r.status||r.statusCode):0;
            if(e||code!==200){end(null,code?'HTTP '+code:String(e||'无响应'));return;}
            var obj;try{obj=typeof d==='string'?JSON.parse(d):d;}catch(err){end(null,'JSON 无效');return;}
            if(!obj||typeof obj!=='object'){end(null,'响应无效');return;}
            end(obj,'HTTP 200');
          });}catch(e){end(null,'请求异常');}
        }
        function validIp(v){return typeof v==='string'&&/^[0-9a-f:.]+$/i.test(v)&&v.length<=45&&(v.indexOf(':')>=0||/^\d{1,3}(\.\d{1,3}){3}$/.test(v)&&v.split('.').every(function(s){return Number(s)<=255;}));}
        function render(){
          if(finished)return;
          if(!primary){log({ipquery:statusA,proxycheck:statusB});done('IP·—','查询失败或超时','exclamationmark.shield');return;}
          var d=primary,r=d.risk||{},loc=d.location||{},isp=d.isp||{},p=secondary||{},det=p.detections||{},net=p.network||{};
          var a=score(r.risk_score),b=score(det.risk),scores=[a,b].filter(function(v){return v!==null;}),count=scores.length;
          var dc=merge(r.is_datacenter,det.hosting===true||String(net.type||'').toLowerCase()==='hosting'?true:det.hosting===false?false:null);
          var proxy=merge(r.is_proxy,det.proxy),vpn=merge(r.is_vpn,det.vpn),tor=merge(r.is_tor,det.tor);
          var scraper=det.scraper===true,compromised=det.compromised===true;
          // Reference purity policy: documented ProxyCheck baseline points, applied only to positively detected classifications.
          // Database risk scores remain unchanged in logs. No numerical score is fabricated when neither database supplies one.
          var floor=Math.max(dc===true?33:0,vpn===true?50:0,tor===true||scraper?75:0,proxy===true||compromised?100:0);
          var actual=count?Math.max.apply(null,scores):null;
          var ref=count?Math.max(actual,floor):null,quality=ref===null?null:100-ref;
          var hits=[dc,proxy,vpn,tor,scraper,compromised].indexOf(true)>=0;
          var uncertain=[dc,proxy,vpn,tor].some(function(x){return x===null;});
          var cc=clean(loc.country_code||((p.location||{}).country_code)||'').toUpperCase();
          var detail={ip:d.ip,checkedAt:new Date().toISOString(),country:cc,city:clean(loc.city||((p.location||{}).city_name)),isp:clean(isp.isp||isp.org||net.provider),asn:clean(String(isp.asn||net.asn||'')),sources:{ipquery:statusA,proxycheck:statusB},scores:{ipquery:a,proxycheck:b},sourceCount:count,rawMaxRisk:actual,classificationFloor:floor,referenceRisk:ref,referencePurity:quality,flags:{hosting:dc,proxy:proxy,vpn:vpn,tor:tor,scraper:det.scraper===true?true:det.scraper===false?false:null,compromised:det.compromised===true?true:det.compromised===false?false:null}};
          log(detail);
          var displayIp=d.ip;
          if(displayIp.length>15&&displayIp.indexOf(':')>=0)displayIp=displayIp.slice(0,7)+'…'+displayIp.slice(-5);
          var title='IP·'+(quality===null?'—':quality+(count===1?'*':''));
          var icon=hits||ref!==null&&ref>=25?'exclamationmark.shield':quality===null||uncertain||count<2?'shield.lefthalf.filled':'checkmark.shield';
          done(title,flag(cc)+displayIp,icon,'https://ipquery.io/ip/'+encodeURIComponent(d.ip));
        }
        setTimeout(function(){if(statusA==='未完成')statusA='超时';if(statusB==='未完成')statusB='超时或未查询';render();},15000);
        request('https://api.ipquery.io/?format=json',6,function(d,why){
          statusA=why;
          if(!d||!validIp(d.ip)){if(d)statusA='IP 字段缺失或无效';statusB='未查询';render();return;}
          primary=d;
          if(score((d.risk||{}).risk_score)===null)statusA='HTTP 200 / 无有效风险分';
          request('https://proxycheck.io/v3/'+encodeURIComponent(d.ip)+'?tag=0&ver=24-June-2026',7,function(x,reason){
            statusB=reason;
            if(x&&(x.status==='ok'||x.status==='warning')){
              var key=Object.keys(x).filter(function(k){return k.toLowerCase()===d.ip.toLowerCase();})[0];
              if(key&&x[key]&&typeof x[key]==='object'){
                secondary=x[key];
                if(score((secondary.detections||{}).risk)===null)statusB='HTTP 200 / 无有效风险分';
                else if(x.status==='warning')statusB='HTTP 200 / API warning';
              }else statusB='HTTP 200 / IP 记录缺失';
            }else if(x)statusB='HTTP 200 / '+String(x.status||'无效状态');
            render();
          });
        });
      })();
  wzw-ai-service-slate-node-43:
    interval: 86400
    payload: |
      (function () {
        var services=[
          {name:'Chatgpt',web:'https://chatgpt.com/',api:'https://api.openai.com/v1/models',headers:{}},
          {name:'Claude',web:'https://claude.ai/',api:'https://api.anthropic.com/v1/models',headers:{'anthropic-version':'2023-06-01'}},
          {name:'Gemini',web:'https://gemini.google.com/',api:'https://generativelanguage.googleapis.com/v1beta/models',headers:{}}
        ];
        var results=services.map(function(){return {web:null,api:null};}),left=6,finished=false;
        function time(){var d=new Date();return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);}
        function finish(){
          if(finished)return;finished=true;
          var responded=0,normal=0,restricted=0,failed=0,signs=[],delays=[],detail=[];
          var labels=['Chatgpt','Claude','Gemini'];
          services.forEach(function(s,i){
            var w=results[i].web||{text:'超时',state:'fail',http:false},a=results[i].api||{text:'超时',state:'fail',http:false};
            var has=w.http||a.http,ok=w.state==='ok'&&(a.state==='ok'||a.state==='auth'),region=w.state==='region'||a.state==='region';
            if(has)responded++;if(ok)normal++;if(region)restricted++;if(!has)failed++;
            var sign=ok?'✓':region||!has?'×':'◐';
            signs.push(labels[i]+sign);
            delays.push(typeof a.ms==='number'&&a.http?(a.ms<10000?String(Math.max(0,Math.round(a.ms))):'10k+'):'—');
            detail.push({name:s.name,web:w,api:a,sign:sign});
          });
          try{console.log('Ai details '+JSON.stringify({responded:responded,services:detail}));}catch(e){}
          $done({title:'AI·'+responded,content:signs.join(' '),
            icon:restricted>0||failed>0?'exclamationmark.triangle':'sparkles',
            backgroundColor:'#303745'});
        }
        function classify(s,kind,error,res,data,ms){
          var code=res?Number(res.status||res.statusCode):0;
          function out(text,state){return {text:text,state:state,http:!!code,ms:ms};}
          if(error||!code)return {text:/timeout|timed out|超时/i.test(String(error))?'超时':'连接失败',state:'fail',http:false,ms:ms};
          var str=typeof data==='string'?data:'',obj=null;
          try{obj=JSON.parse(str);}catch(e){}
          var er=obj&&obj.error?obj.error:{},message=typeof er.message==='string'?er.message:'',errcode=String(er.code||''),errtype=String(er.type||''),details=JSON.stringify(er.details||[]);
          var headers=res.headers||{},loc='',challenge=false;
          Object.keys(headers).forEach(function(k){var v=String(headers[k]||'');if(k.toLowerCase()==='location')loc=v;if(k.toLowerCase()==='cf-mitigated'&&/challenge/i.test(v))challenge=true;});
          var regionText=kind==='api'?message+' '+errcode+' '+errtype+' '+details:loc;
          if(/unsupported[_ -](country|region|territory)|country[_ -]not[_ -]supported|(?:country|region|territory).{0,60}(?:not supported|not available|unsupported)|user location is not supported|not available in (?:your|this) (?:country|region|location)|unavailable[-_]in[-_](?:your[-_])?(?:country|region)/i.test(regionText))return out('地区受限','region');
          if(challenge||/<title[^>]*>\s*just a moment|cf-chl-|attention required!.*cloudflare/i.test(str.slice(0,16000)))return out('安全验证','check');
          if(kind==='web'){
            if(code>=200&&code<300)return out('正常','ok');
            if(code>=300&&code<400)return out('跳转 '+code,'check');
          }else{
            if(code>=200&&code<300&&obj&&(Array.isArray(obj.data)||Array.isArray(obj.models)))return out('正常','ok');
            var auth=false;
            if(s.name==='Chatgpt')auth=code===401&&!!obj&&/api.?key|bearer|authentication|authorization/i.test(message+' '+errcode+' '+errtype);
            if(s.name==='Claude')auth=code===401&&!!obj&&(/authentication_error/i.test(errtype)||/api.?key|authentication/i.test(message));
            if(s.name==='Gemini')auth=[400,401,403].indexOf(code)>=0&&!!obj&&/API_KEY_INVALID|API_KEY_MISSING|API key|unregistered callers?|API keys|UNAUTHENTICATED/i.test(message+' '+details+' '+String(er.status||''));
            if(auth)return out('待鉴权','auth');
          }
          if(code===403)return out('403 待确认','check');
          if(code===429)return out('限流','check');
          if(code>=500)return out('服务 '+code,'fail');
          return out('HTTP '+code,'check');
        }
        function run(s,i,kind){
          var start=Date.now(),headers={'Accept':kind==='api'?'application/json':'text/html,application/xhtml+xml','Cache-Control':'no-cache, no-store','Pragma':'no-cache'};
          if(kind==='api')Object.keys(s.headers).forEach(function(k){headers[k]=s.headers[k];});
          function record(result){if(finished||results[i][kind])return;results[i][kind]=result;if(--left===0)finish();}
          try{$httpClient.get({url:s[kind],headers:headers,timeout:8,'auto-cookie':false,'auto-redirect':false},function(e,r,d){
            try{record(classify(s,kind,e,r,d,Date.now()-start));}catch(err){record({text:'响应异常',state:'fail',http:false});}
          });}catch(e){record({text:'请求失败',state:'fail',http:false});}
        }
        setTimeout(finish,11000);
        services.forEach(function(s,i){run(s,i,'web');run(s,i,'api');});
      })();
